# Usa l'immagine leggera di Alpine
FROM alpine:latest

# Imposta la directory di lavoro
WORKDIR /app

# Aggiorna, installa GCC, Make e dipendenze necessarie
RUN apk update && \
    apk add --no-cache gcc make libc-dev linux-headers netcat-openbsd

# Copia tutti i file della directory server nel container
COPY . /app/

# Compilazione del server
RUN make clean && make run_server

# Espone la porta 10000
EXPOSE 10000

# Comando di avvio del server
CMD ["./server", "10000", "locahost", "5"]
