# Usa l'immagine leggera di Alpine
FROM alpine:latest

# Imposta la directory di lavoro
WORKDIR /app

# Aggiorna, installa GCC, Make e dipendenze necessarie
RUN apk update && \
    apk add --no-cache gcc make libc-dev linux-headers netcat-openbsd

# Copia tutto il contenuto della directory client
COPY . /app/

# Compilazione del client
RUN make clean && make run_client

# Espone la porta 10000
EXPOSE 10000

# Comando di avvio del client
CMD ["./client", "server", "10000", "1"]
